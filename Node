echo "[Zynex] Installing Skyport Daemon..."
git clone https://github.com/skyport-team/skyportd
if [ ! -d "skyportd" ]; then
    echo "[Zynex] ERROR: Failed to clone skyportd."
    exit 1
fi

echo "[Zynex] Installing dependencies..."
cd skyportd
npm install

